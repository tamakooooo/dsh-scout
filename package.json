{
  "name": "@local/dsh-jev-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Host plugin bundle: drive a real Chrome over raw CDP, with TypeSafe Jev (System One) choosing each step. Contributes a 招聘工作台 sidebar entry and its page to the Harness Web UI.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tamakooooo/dsh-scout.git"
  }
}
